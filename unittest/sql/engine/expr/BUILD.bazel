load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
package(default_testonly = True)

cc_library(
    name = "ob_expr_ai_prompt_test_cases",
    srcs = ["ob_expr_ai_prompt_test.cpp"],
    alwayslink = True,
    deps = ["@seekdb_3rd_headers//:gtest", "//src/sql:ai_test_headers"],
)
cc_test(
    name = "ob_expr_ai_prompt_test",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [":ob_expr_ai_prompt_test_cases", "//src/observer:liboceanbase"],
    target_compatible_with = ["@platforms//os:linux"],
)

