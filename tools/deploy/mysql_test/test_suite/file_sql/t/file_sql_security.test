eval SELECT * FROM read_csv('$file_sql_data_dir/../outside.csv');
--error 1210
SELECT * FROM glob('/etc/*.csv');
SELECT 1 AS still_running;
--source mysql_test/test_suite/file_sql/include/cleanup.inc
