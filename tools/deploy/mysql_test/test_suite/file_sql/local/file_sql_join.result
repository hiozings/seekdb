SELECT a.id,b.label FROM read_csv('FILE_SQL_DATA/basic.csv') AS a LEFT JOIN read_ndjson('FILE_SQL_DATA/basic.jsonl') AS b ON a.id=b.id ORDER BY a.id;
id	label
1	first
2	NULL
3	third
SELECT a.id,b.name FROM read_csv('FILE_SQL_DATA/basic.csv') a INNER JOIN read_parquet('FILE_SQL_DATA/basic1.parquet') b ON a.id=b.id ORDER BY a.id;
id	name
1	Alice
2	NULL
3	C, D
SELECT /*+ USE_NL(a b) */ COUNT(*) AS matched FROM read_csv('FILE_SQL_DATA/basic.csv') a JOIN read_csv('FILE_SQL_DATA/basic.csv') b ON a.id=b.id;
matched
3
