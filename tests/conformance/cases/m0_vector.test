-- Vector projection, exact TopK, filtered TopK and tie handling.
CREATE TABLE docs (id BIGINT PRIMARY KEY, category VARCHAR(32), content VARCHAR(1024), embedding VECTOR(4));
INSERT INTO docs VALUES
    (1, 'database', '事务与恢复', '[1, 0, 0, 0]'),
    (2, 'database', '向量索引',   '[0, 1, 0, 0]'),
    (3, 'travel',   '旅行攻略',   '[0, 0, 1, 0]'),
    (4, 'database', '并列项',     '[1, 0, 0, 0]');

SELECT id, content,
       L2_DISTANCE(embedding, '[0.9, 0.1, 0, 0]') AS distance
FROM docs
WHERE category = 'database'
ORDER BY distance
LIMIT 2;

-- Filtered TopK must be computed inside the matching set only.
SELECT id, L2_DISTANCE(embedding, '[0, 0, 0, 0]') AS distance
FROM docs
WHERE category = 'travel'
ORDER BY distance;

-- Equal distances are ordered by primary key ascending.
SELECT id, L2_DISTANCE(embedding, '[0, 0, 0, 0]') AS distance
FROM docs
WHERE category = 'database'
ORDER BY distance;

SELECT id, embedding FROM docs WHERE id = 3;
