-- Transactions: read-your-writes, rollback, commit.
CREATE TABLE t (id BIGINT PRIMARY KEY, v VARCHAR(8));
INSERT INTO t VALUES (1, 'a');

BEGIN;
INSERT INTO t VALUES (2, 'b');
UPDATE t SET v = 'z' WHERE id = 1;
SELECT id, v FROM t ORDER BY id;
ROLLBACK;
SELECT id, v FROM t ORDER BY id;

BEGIN;
INSERT INTO t VALUES (3, 'c');
COMMIT;
SELECT id FROM t ORDER BY id;

-- A failed statement inside a transaction leaves earlier statements intact.
BEGIN;
INSERT INTO t VALUES (4, 'd');
INSERT INTO t VALUES (4, 'dup');
SELECT id, v FROM t ORDER BY id;
ROLLBACK;
SELECT id FROM t ORDER BY id;
