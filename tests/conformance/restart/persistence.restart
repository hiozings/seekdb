-- Persistence across restarts: every committed change must survive.
CREATE TABLE p (id BIGINT PRIMARY KEY, category VARCHAR(16), v VARCHAR(16), e VECTOR(2));
INSERT INTO p VALUES (1, 'a', 'one', '[1, 0]'), (2, 'b', 'two', '[0, 1]'), (3, 'a', 'three', '[1, 1]');

-- restart
SELECT id, category, v FROM p ORDER BY id;
SELECT id, L2_DISTANCE(e, '[1, 0]') AS d FROM p ORDER BY d;

UPDATE p SET v = 'first' WHERE id = 1;
DELETE FROM p WHERE id = 2;

-- restart
SELECT id, v FROM p ORDER BY id;
SELECT id FROM p WHERE category = 'a' ORDER BY id;

-- restart
INSERT INTO p VALUES (4, 'c', 'four', '[0, 0]');
SELECT id, v FROM p ORDER BY id;

-- restart
SELECT id, v FROM p ORDER BY id;
